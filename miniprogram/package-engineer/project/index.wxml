<view class="screen">
  <view wx:if="{{loading}}" class="loading-state">正在加载项目…</view>
  <view wx:elif="{{error}}" class="error-state">{{error}}<button class="secondary-action" bindtap="refresh">重新加载</button></view>
  <block wx:else>
    <view class="page-kicker">{{project.customerDisplayName || '定制项目'}} · {{project.community}}</view><view class="page-title">{{project.title}}</view>
    <view class="section-top section"><view class="section-title">安装位置</view><button class="text-link" bindtap="addLocation">＋ 添加位置</button></view>
    <scroll-view wx:if="{{locations.length}}" class="location-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="location-inner"><button wx:for="{{locations}}" wx:key="_id" class="location-tab {{selectedId === item._id ? 'active' : ''}}" data-id="{{item._id}}" bindtap="chooseLocation">{{item.name}}</button></view></scroll-view>
    <view wx:if="{{isDevelopmentTest && selected && !editing}}" class="surface section"><view class="section-title">非客户测试工具 · 仅开发版</view><view class="muted generation-note">只上传内置色块测试图，不使用客户资料、不调用 AI、不创建分享。</view><button class="secondary-action generation-button" bindtap="verifyDevelopmentStorage" disabled="{{busy}}">验证私有存储（保留测试图）</button></view>

    <form wx:if="{{editing}}" class="surface editor" bindsubmit="saveLocation"><view class="section-title">{{editingId ? '编辑安装位置' : '添加安装位置'}}</view>
      <view wx:if="{{isDevelopmentTest}}" class="muted generation-note">仅开发版测试项目可用；填入后仍需手动保存。<view class="action-row"><button class="text-link" data-kind="balcony" bindtap="fillDevelopmentLocation">填入转角阳台样例</button><button class="text-link" data-kind="canopy" bindtap="fillDevelopmentLocation">填入雨棚样例</button></view><button class="text-link" data-kind="draft" bindtap="fillDevelopmentLocation">填入纯文字草稿（清空结构与尺寸）</button></view>
      <view class="field-label">安装位置名称 *</view><input class="field" name="name" value="{{form.name}}" data-field="name" bindinput="updateForm" maxlength="60" placeholder="如：阳台、卧室窗、入户雨棚" />
      <view class="field-label">产品组合 *</view><checkbox-group class="product-options" bindchange="chooseProducts"><label wx:for="{{productOptions}}" wx:key="id" class="product-option"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#ae592e" /><text>{{item.title}}</text></label></checkbox-group>
      <view class="field-label">现场总尺寸（毫米）</view><view class="dimension-fields"><input class="field" type="digit" name="widthMm" value="{{form.widthMm}}" data-field="widthMm" bindinput="updateForm" placeholder="宽 / 长" /><input class="field" type="digit" name="heightMm" value="{{form.heightMm}}" data-field="heightMm" bindinput="updateForm" placeholder="高" /><input class="field" type="digit" name="depthMm" value="{{form.depthMm}}" data-field="depthMm" bindinput="updateForm" placeholder="深" /></view>
      <view class="field-label">材料 / 材质 *</view><input class="field" name="material" value="{{form.material}}" data-field="material" bindinput="updateForm" maxlength="300" placeholder="如：304 不锈钢、铝合金型材" />
      <view class="field-label">表面处理</view><input class="field" name="finish" value="{{form.finish}}" data-field="finish" bindinput="updateForm" maxlength="200" placeholder="如：拉丝、镜面、喷涂" />
      <view class="field-label">颜色</view><input class="field" name="color" value="{{form.color}}" data-field="color" bindinput="updateForm" maxlength="100" placeholder="填写客户指定颜色" />

      <view class="plan-heading"><view class="section-title">分面与分格方案</view><view class="muted">按工程师简图逐项录入，不自动猜测数字或箭头。安装面是实际结构面，不是照片视角。可先保存不完整草稿，生成前再补齐。</view></view>
      <view wx:for="{{structurePlan.faces}}" wx:for-item="face" wx:for-index="faceIndex" wx:key="id" class="face-editor">
        <view class="section-top"><text class="plan-label">安装面 {{faceIndex + 1}}</text><button class="text-link" data-face-id="{{face.id}}" bindtap="removeStructure">移除安装面</button></view>
        <input class="field" value="{{face.name}}" data-face-id="{{face.id}}" data-field="name" bindinput="updatePlan" maxlength="60" placeholder="如：正面、左侧转角面" />
        <view class="field-label">本面总宽 / 高（毫米）</view><view class="dimension-fields"><input class="field" type="digit" value="{{face.widthMm}}" data-face-id="{{face.id}}" data-field="widthMm" bindinput="updatePlan" placeholder="总宽" /><input class="field" type="digit" value="{{face.heightMm}}" data-face-id="{{face.id}}" data-field="heightMm" bindinput="updatePlan" placeholder="总高" /></view>
        <view class="field-label">与相邻安装面的关系</view><input class="field" value="{{face.corner}}" data-face-id="{{face.id}}" data-field="corner" bindinput="updatePlan" maxlength="300" placeholder="如：从室内看，与正面左端成 90° 转角" />
        <view class="field-label">局部避让 / 缺口</view><textarea class="field textarea compact-textarea" value="{{face.obstacles}}" data-face-id="{{face.id}}" data-field="obstacles" bindinput="updatePlan" maxlength="500" placeholder="记录梁、柱、管道的位置和避让尺寸；没有可留空" />
        <view wx:for="{{face.cells}}" wx:for-item="cell" wx:for-index="cellIndex" wx:key="id" class="cell-editor">
          <view class="section-top"><text class="plan-label">分格 {{cellIndex + 1}}</text><button class="text-link" data-face-id="{{face.id}}" data-cell-id="{{cell.id}}" bindtap="removeStructure">移除</button></view>
          <input class="field" value="{{cell.name}}" data-face-id="{{face.id}}" data-cell-id="{{cell.id}}" data-field="name" bindinput="updatePlan" maxlength="60" placeholder="如：左上窗扇、下部栏杆、整面固定区" />
          <view class="field-label">分格宽 / 高（毫米）</view><view class="dimension-fields"><input class="field" type="digit" value="{{cell.widthMm}}" data-face-id="{{face.id}}" data-cell-id="{{cell.id}}" data-field="widthMm" bindinput="updatePlan" placeholder="分格宽" /><input class="field" type="digit" value="{{cell.heightMm}}" data-face-id="{{face.id}}" data-cell-id="{{cell.id}}" data-field="heightMm" bindinput="updatePlan" placeholder="分格高" /></view>
          <view class="field-label">开启方式 *</view><picker range="{{openingLabels}}" value="{{cell.openingIndex}}" data-face-id="{{face.id}}" data-cell-id="{{cell.id}}" bindchange="chooseOpening"><view class="picker-value">{{openingLabels[cell.openingIndex]}} ▾</view></picker>
          <view wx:if="{{cell.opening !== 'fixed'}}"><view class="field-label">开启方向 / 操作说明</view><input class="field" value="{{cell.direction}}" data-face-id="{{face.id}}" data-cell-id="{{cell.id}}" data-field="direction" bindinput="updatePlan" maxlength="200" placeholder="说明观察侧、左右与内外，勿仅写一个箭头" /></view>
          <view class="field-label">本分格补充说明</view><input class="field" value="{{cell.notes}}" data-face-id="{{face.id}}" data-cell-id="{{cell.id}}" data-field="notes" bindinput="updatePlan" maxlength="400" placeholder="产品、纱窗、栏杆关系或特殊材料等" />
        </view>
        <button class="secondary-action add-structure" data-face-id="{{face.id}}" bindtap="addCell">＋ 添加分格 / 整面单元</button>
      </view>
      <button class="secondary-action add-structure" bindtap="addFace">＋ 添加安装面</button>
      <view class="field-label">玻璃配置</view><input class="field" value="{{structurePlan.glass}}" data-field="glass" bindinput="updatePlan" maxlength="300" placeholder="按客户与工程师已确认的配置录入，可留空" />
      <view class="field-label">五金要求</view><input class="field" value="{{structurePlan.hardware}}" data-field="hardware" bindinput="updatePlan" maxlength="300" placeholder="执手、铰链等要求，不确定时不要猜测" />
      <view class="field-label">禁止改变项</view><textarea class="field textarea compact-textarea" value="{{structurePlan.constraints}}" data-field="constraints" bindinput="updatePlan" maxlength="1000" placeholder="如：保留原墙面、洞口和梁柱，不增加未确认的窗扇" />
      <view class="field-label">结构简图的补充文字说明</view><textarea class="field textarea" name="structureNotes" value="{{form.structureNotes}}" data-field="structureNotes" bindinput="updateForm" maxlength="2000" placeholder="补充分面分格未覆盖的结构。已有纯文字方案仍可使用；当前不会自动识别手绘图。" />
      <view class="field-label">客户要求</view><textarea class="field textarea" name="customerRequirements" value="{{form.customerRequirements}}" data-field="customerRequirements" bindinput="updateForm" maxlength="2000" placeholder="样式、采光、通风等补充要求" />
      <view class="action-row"><button class="primary-action" form-type="submit" disabled="{{busy}}" loading="{{busy}}">保存位置</button><button class="secondary-action" bindtap="cancelEdit">取消</button></view>
    </form>

    <view wx:if="{{!locations.length && !editing}}" class="empty-state"><view class="empty-title">先添加一个安装位置</view><view class="muted">一个位置可以组合多个产品，并记录尺寸和材料要求。</view></view>
    <block wx:if="{{selected && !editing}}">
      <view class="surface section"><view class="section-top"><view class="section-title">{{selected.name}}</view><button class="text-link" bindtap="editLocation">编辑要求</button></view><view class="muted">{{selected.material}} · {{selected.finish || '表面处理待确认'}} · {{selected.color || '颜色待确认'}}</view><view class="muted location-facts">产品组合：{{productLabel}}</view><view class="muted location-facts">现场总尺寸：{{dimensionLabel}}</view><view wx:if="{{structureSummary}}" class="structure-note">{{structureSummary}}</view><view wx:if="{{selected.structureNotes}}" class="structure-note">{{selected.structureNotes}}</view></view>
      <view class="section"><view class="section-top"><view class="section-title">现场资料</view><button class="text-link" bindtap="upload" disabled="{{busy}}">＋ 上传图片</button></view><view class="asset-grid"><button wx:for="{{assets}}" wx:key="_id" class="asset" data-url="{{item.previewUrl}}" bindtap="preview"><image src="{{item.previewUrl}}" mode="aspectFill" /><text>{{item.typeLabel}}</text></button></view><view wx:if="{{!assets.length}}" class="muted">上传现场多角度照片、工程师结构简图和材质参考图。</view></view>
      <view class="surface section"><view class="section-title">生成多角度效果预览</view><view class="muted generation-note">每个角度选一张对应现场照片，可选“不生成此角度”。当前按单张现场图与已确认文字生成，不自动读取简图。下一步先核对完整方案，不会立即调用 AI。</view><view wx:for="{{views}}" wx:key="angle" class="view-picker"><text>{{item.angle}}</text><picker range="{{sourceNames}}" value="{{item.sourceIndex + 1}}" data-index="{{index}}" bindchange="chooseSource" disabled="{{!sitePhotos.length}}"><view class="picker-value">{{item.sourceLabel}} ▾</view></picker><image wx:if="{{item.sourceUrl}}" class="source-thumb" src="{{item.sourceUrl}}" mode="aspectFill" data-url="{{item.sourceUrl}}" bindtap="preview" /></view><button class="primary-action generation-button" bindtap="generate" disabled="{{busy || !sitePhotos.length}}">下一步：确认生成方案</button></view>
      <view wx:if="{{jobs.length}}" class="section"><view class="section-top"><view class="section-title">生成任务</view><button class="text-link" bindtap="refresh">刷新进度</button></view><view wx:for="{{jobs}}" wx:key="_id" class="job"><view class="job-top"><text>{{item.angle}}</text><text class="job-status">{{item.statusLabel}}</text></view><view wx:if="{{item.errorMessage}}" class="muted">{{item.errorMessage}}</view><button wx:if="{{item.status === 'failed'}}" class="text-link" data-id="{{item._id}}" bindtap="retryJob" disabled="{{busy}}">处理原因后重试 →</button></view></view>
      <view wx:if="{{renders.length}}" class="section"><view class="section-title">效果图审核</view><view class="muted generation-note">核对结构、数量、材质、颜色和多角度一致性后确认。</view><view wx:for="{{renders}}" wx:key="_id" class="render"><image class="render-image" src="{{item.previewUrl}}" mode="widthFix" data-url="{{item.previewUrl}}" bindtap="preview" /><view class="render-info"><view class="job-top"><text>{{item.angle}}</text><text class="job-status">{{item.reviewLabel}}</text></view><view class="action-row"><button class="secondary-action" data-id="{{item._id}}" data-decision="rejected" bindtap="review" disabled="{{busy}}">需调整</button><button class="primary-action" data-id="{{item._id}}" data-decision="approved" bindtap="review" disabled="{{busy || item.reviewStatus === 'approved'}}">{{item.reviewStatus === 'approved' ? '已确认' : '确认通过'}}</button></view></view></view></view>
    </block>
    <view class="section surface"><view class="section-title">分享给客户</view><view class="page-intro">只包含已审核确认的效果图。分享版本有效期 30 天，可手动停用。</view><button class="primary-action share-create" bindtap="createShare" disabled="{{busy}}">生成新的专属分享</button><view wx:if="{{sharePath}}"><view class="muted generation-note">有效期至 {{shareExpiry}}</view><view class="action-row"><button class="secondary-action" bindtap="previewShare">客户视角预览</button><button class="primary-action" open-type="share">微信分享</button></view></view><view wx:for="{{shares}}" wx:key="_id" class="share-record"><text>有效期至 {{item.expiryLabel}}</text><button class="text-link" data-id="{{item._id}}" bindtap="disableShare" disabled="{{busy}}">停用</button></view></view>
  </block>
</view>
