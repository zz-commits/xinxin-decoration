<view class="screen">
  <view class="page-kicker">ENGINEER WORKSPACE</view><view class="page-title">工程师工作台</view><view class="page-intro">以项目组织资料，以安装位置沟通方案。</view>
  <view wx:if="{{loading}}" class="loading-state">正在验证权限…</view>
  <view wx:elif="{{error}}" class="error-state section">{{error}}<button class="secondary-action" bindtap="refresh">重新连接</button></view>
  <view wx:elif="{{!profile.authorized}}" class="surface section"><view class="section-title">尚未开通工程师权限</view><view class="page-intro">将当前微信身份标识交给店铺管理员，在云开发后台加入工程师白名单后再进入。</view><text class="identity-value" user-select>{{profile.openid}}</text><button class="secondary-action identity-button" bindtap="copyIdentity">复制我的身份标识</button><view class="muted identity-note">此处仅显示你自己的微信身份，请勿发到公开页面。只有管理员配置的工程师可以录入资料和生成效果图。</view></view>
  <block wx:else>
    <view class="section section-top"><view class="section-title">{{profile.name}}的项目</view><button class="text-link" bindtap="toggleCreate">{{showCreate ? '取消新建' : '＋ 新建项目'}}</button></view>
    <form wx:if="{{showCreate}}" class="surface project-form" bindsubmit="createProject"><view wx:if="{{isDevelopment}}" class="muted identity-note">仅开发版联调工具；样例不代表真实施工方案。<button class="text-link" bindtap="fillDevelopmentProject" disabled="{{saving}}">填入测试项目样例</button></view><view class="field-label">项目名称 *</view><input class="field" name="title" value="{{projectForm.title}}" data-field="title" bindinput="updateProjectForm" placeholder="如：四河小区门窗与阳台改造" maxlength="100" /><view class="field-label">客户称呼</view><input class="field" name="customerDisplayName" value="{{projectForm.customerDisplayName}}" data-field="customerDisplayName" bindinput="updateProjectForm" placeholder="如：张女士" maxlength="60" /><view class="field-label">小区 / 项目地点</view><input class="field" name="community" value="{{projectForm.community}}" data-field="community" bindinput="updateProjectForm" placeholder="填写项目所在小区" maxlength="100" /><button class="primary-action save-button" form-type="submit" loading="{{saving}}" disabled="{{saving}}">创建项目</button></form>
    <button wx:for="{{items}}" wx:key="_id" class="project-row" data-id="{{item._id}}" bindtap="openProject"><view class="project-top"><text class="project-title">{{item.title}}</text><text class="project-status">{{item.statusLabel}}</text></view><view class="muted project-subtitle">{{item.customerDisplayName || '客户称呼未填'}} · {{item.community || '地点待补充'}}</view><text class="project-arrow">进入项目 →</text></button>
    <view wx:if="{{!items.length && !showCreate}}" class="empty-state"><view class="empty-title">从第一个项目开始</view><view class="muted">新建项目后，添加阳台、卧室窗等安装位置。</view><button class="primary-action first-project" bindtap="toggleCreate">新建项目</button></view>
  </block>
</view>
